# Normaliza texto para LF no repo (checkout CRLF nao quebra o install).
* text=auto
*.ps1 text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.tmpl text eol=lf
*.yml text eol=lf
*.txt text eol=lf
# Artefatos de dist sao byte-estaveis: o sidecar .sha256 casa com os bytes do
# blob; traducao de EOL no checkout (autocrlf) quebraria o hash (CHECK 16).
plugins/dist/** -text
