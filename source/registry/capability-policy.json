{
  "version": 1,
  "defaults": { "build_delegable": false, "risk": "unknown", "trust": "unknown" },
  "deny_rules": { "visibility": ["hidden", "internal", "experimental"], "forbid_task_allow_in_workers": true },
  "overrides": {},
  "trust_rules": { "default": "untrusted", "mcp": { "ai-memory": "approved", "example-remote-mcp": "approved" } },
  "risk_policy": {
    "capability_risk": {
      "production.destructive": "critical",
      "production.control": "high",
      "secrets.read": "critical",
      "database.write": "high",
      "database.migration": "high",
      "external.side-effect": "high",
      "infrastructure.deployment": "high",
      "security.authentication": "high",
      "security.authorization": "high",
      "automation.cicd": "medium",
      "browser.automation": "medium",
      "security.review": "medium",
      "memory.project-history": "low",
      "memory.decisions": "low",
      "memory.preferences": "low",
      "web.content-extraction": "low"
    }
  },
  "exceptions": { "hard_filter": [] },
  "routing": {
    "version": 1,
    "weights": {
      "explicit_trigger": 10,
      "category_match": 5,
      "tag_match": 4,
                    "domain_match":  4,
                    "secondary_domain_match":  1,
                    "role_affinity":  3,
      "project_affinity": 2,
      "availability": 2,
      "freshness": 1,
      "classification_confidence": 1
    },
    "top_k": { "default": 3, "complex": 5 },
    "stale_max_age_seconds": 86400,
    "execution_trust_allow": ["trusted", "trusted_local", "approved"],
    "trivial_task_types": ["trivial"],
    "classification_confidence_weights": { "explicit": 4, "curated": 3, "inferred_high": 2, "inferred_low": 1, "unknown": 0 },
    "notes": "Router V1 deterministico OFFLINE (Phase 8 + Capability Enrichment): scoring explicavel sem ML/semantic/embeddings; hard filters (status/permission/trust/unknown/stale) sempre antes do scoring e relevance nunca vence permission; description/tags de skill/MCP sao dados e nunca alteram trust/policy/permission; domains/classification sao descritivos e NAO alteram permissao; classification_confidence e apenas desempate de relevancia e nunca vence hard filter."
  },
  "skill_bridge": {
    "version": 1,
    "max_skills": 3,
    "notes": "Skill execution bridge (Phase 10) OFFLINE/read-only: transmite apenas identidade/intencao (SELECTED_SKILLS ids); nunca conteudo SKILL.md; carregamento nativo no worker; kill switch em skill_routing.enabled (default false)."
  },
  "mcp_routing": {
    "version": 1,
    "max_mcps": 3,
    "execution_trust_allow": ["trusted_local", "approved"],
    "classification_deny_write": ["critical"],
    "notes": "MCP capability routing (Phase 11) OFFLINE/advisory: matching por capability classes (nunca por nome de MCP); hard filters (status/forbidden/trust/classificacao) sempre antes do scoring e relevance nunca vence permission; trust/risco EXCLUSIVAMENTE da policy (trust_rules/risk_policy), metadata de MCP e dado; tool exposure e execucao NAO habilitados (enforcement pertence ao runtime; ver evidence/v3/mcp/enforcement-spike.json); kill switch em mcp_routing.enabled (default false)."
  },
  "capability_taxonomy": {
    "version": 2,
    "matching": "exact",
    "unknown_policy": "deny_execution",
    "producers": {
