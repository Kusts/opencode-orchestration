      "technical_justification",
      "additional_capacity_needed",
      "provider_available",
      "budget_authorized",
      "delimited_scope"
    ]
  },
  "jev": {
    "model": "jev-1.13-free",
    "service": "OpenCode / System One",
    "endpoint": "https://opencode.ai/inference/systemone/v1/systemone",
    "mode": "advisory",
    "transport": "System One",
    "authority": "advisory-only"
  },
  "fallback_policy": {
    "max_attempts": 4,
    "prefer_same_tier": true,
    "prevent_cycles": true,
    "prohibited_downgrades": [
      "reviewer",
      "security-reviewer"
    ],
    "cross_provider_tracking": true,
    "prohibitions": [
      "fallback_loops",
      "unknown_models",
      "incompatible_downgrade",
      "silent_provider_switch",
      "duplicate_execution_on_ambiguous",
      "zero_cost_on_unknown",
      "unverified_t3_escalation",
      "unverified_astra_escalation",
      "fallback_on_unverified_error"
    ]
  },
  "cost_policy": {
    "t4_requires_authorization": false,
    "astra_requires_exceptional_authorization": false,
    "unknown_cost_handling": "UNKNOWN"
  },
  "runtime_verification": {
    "match_kinds": [
      "EXACT_MATCH",
      "AUTHORIZED_FALLBACK",
      "UNAUTHORIZED_MISMATCH",
      "PROOF_ABSENT"
    ],
    "require_exact_provider_match": true,
    "fail_closed_on_unproven_override": true,
    "require_failure_receipt_for_t4_escalation": true,
    "require_failure_receipt_for_astra": true
  }
