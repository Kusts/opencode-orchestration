{
  // Model Router v1.4: Planner (agente build, sessao raiz) usa hy4 (tier operacional T1).
  // Planner usa hy4; Luna e fallback T1 apenas com prova independente de nao-inicio.
  // O modelo global (topo do opencode.json) segue este pool T1 (free), derivado da policy; nao e fixo no template.
  // Derivado de source/registry/model-routing-policy.json por install/reconcile.
  // Nao edite manualmente para trocar modelos; altere a policy e aplique novamente.
  "planner": "opencode-go/hy4-flash-free",
  // T2: primary Luna; alternativas DeepSeek Go->Muse->Haiku (mesmo tier; exaustao de transporte nunca sobe de tier).
  "cheap": "openai/gpt-6-luna",
  // T1: hy4 (OpenCode Go); fallback opencode/mimo-v2.6-flash-free.
  "free": "opencode-go/hy4-flash-free",
  // T3: Terra (openai/gpt-6.1-terra) e a primaria; Sonnet (claude-agent/sonnet) permanece como alternativa de mesmo tier com resolucao runtime-unverified. Rollback = reverter estes campos.
  "strong": "openai/gpt-6.1-terra",
  // T4: Sol (openai/gpt-6.1-sol) e a primaria; Opus (claude-agent/opus) permanece como alternativa de mesmo tier com resolucao runtime-unverified. Transporte mesmo tier Sol->Opus; candidatas T2 degradadas DeepSeek Go->Muse apenas audit-only HOLD para papeis admissiveis a T2 (sem retry); Astra excepcional e proof-gated (orcamento excepcional), Fable em HOLD, nunca automaticos.
  "frontier": "openai/gpt-6.1-sol"
}
