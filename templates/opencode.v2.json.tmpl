        { "action": "subagent", "resource": "*", "effect": "deny" },
        { "action": "subagent", "resource": "ai-agent-engineer", "effect": "allow" },
        { "action": "subagent", "resource": "architect", "effect": "allow" },
        { "action": "subagent", "resource": "automation-engineer", "effect": "allow" },
        { "action": "subagent", "resource": "backend-engineer", "effect": "allow" },
