        { "action": "subagent", "resource": "database-engineer", "effect": "allow" },
        { "action": "subagent", "resource": "debugger", "effect": "allow" },
        { "action": "subagent", "resource": "docs-manager", "effect": "allow" },
        { "action": "subagent", "resource": "engineering-advisor", "effect": "allow" },
        { "action": "subagent", "resource": "explorer", "effect": "allow" },
        { "action": "subagent", "resource": "frontend-engineer", "effect": "allow" },
